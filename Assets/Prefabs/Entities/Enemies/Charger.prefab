  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 46216fa097ecb754babda0f26d640422, type: 3}
  m_Name: 
  m_EditorClassIdentifier: OkapiKit::OkapiKit.TriggerOnTimer
  _showInfo: 1
  _explanation: "Wait for between 1.5 and 2.5 seconds, and then every 3 to 4.5 seconds,
    trigger the actions::\n          disables component Charger (OkapiKit.MovementFollow)\n         
    select a random velocity between (0.00, 0.00) and (0.00, 0.00) and set it to
    Charger's rigid body.\n          Note that this changes the velocity parameters
    of the movement, not the current velocity.\n          For that, use the 'Change
    Rigid Body' action.\n          blinks renderer Charger for 0.5 seconds\n         
    The renderer will be on 0.06 seconds, and then be turned off 0.06 seconds, in
    a loop.\n then, at 0.5 seconds, \n          enables component Charger (OkapiKit.MovementForward)\n"
  description: 
  enableTrigger: 1
  allowRetrigger: 1
  hasPreconditions: 0
  preConditions: []
  actions:
  - delay: 0
    action: {fileID: 6780318123872391308}
  - delay: 0
    action: {fileID: 6357635789145281248}
  - delay: 0
    action: {fileID: 9036871386292981620}
  - delay: 0.5
    action: {fileID: 8265801469963423104}
  startTriggered: 0
  initialDelayEnable: 1
  initialDelay: {x: 1.5, y: 2.5}
  timeInterval: {x: 3, y: 4.5}
